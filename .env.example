# ---------------------------------------------------------------------------
# Copy to `.env.local` (git-ignored) and fill in.
# The schema in src/lib/env.ts is the source of truth — it will tell you
# exactly what's missing on boot.
# ---------------------------------------------------------------------------

# --- Public (inlined into the client bundle — assume everyone can read these)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# --- Server only (never prefix these with NEXT_PUBLIC_)
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# LLM provider for Snapi's assistant and visual search.
# ANTHROPIC_API_KEY=

# Datastore.
# DATABASE_URL=postgresql://user:password@localhost:5432/snapi
