# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example IS committed; it documents the contract.
.env*
!.env.example

# Full-resolution image originals. Kept locally as a safety net; the committed
# files in src/assets are the downscaled working copies.
src/assets/**/_originals/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
